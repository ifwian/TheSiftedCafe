{
  "name": "the-sifted-cafe",
  "private": true,
  "version": "0.0.0",
  "description": "The Sifted Cafe -- full-stack café website and admin dashboard.",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently -n client,server -c blue,green \"npm run client\" \"npm run server\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "lint": "npm run lint --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
