# Server
#
# Copy to server/.env for local development: `cp .env.example .env`
#
# On Vercel, do NOT set these in files -- configure them in the project
# dashboard under Settings > Environment Variables. The server exits with
# a clear message at startup if a required one is missing, so a bad deploy
# fails fast instead of serving broken responses.

PORT=5000
NODE_ENV=development

# Database connection string (required)
# PostgreSQL in production. Managed Postgres (Neon, Supabase, Vercel
# Postgres) usually requires SSL, hence ?sslmode=require.
DATABASE_URL=postgresql://user:password@localhost:5432/the_sifted_cafe?sslmode=require

# JWT signing secret (required, minimum 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this across environments, and never commit it.
JWT_SECRET=

# Browser origins allowed to call the API.
#
# ALLOWED_ORIGINS is a comma-separated allowlist and takes precedence.
# In production the API is same-origin with the frontend on Vercel, so it
# normally needs no value at all -- add entries only if the client is
# genuinely hosted elsewhere (e.g. https://siftedcafe.com).
ALLOWED_ORIGINS=

# Legacy single-origin value, still honoured. Use for the Vite dev server.
CLIENT_URL=http://localhost:5173

# Gmail SMTP for reservation/message email notifications
# EMAIL_USER: the Gmail address sending notifications
# EMAIL_APP_PASSWORD: a Gmail App Password (NOT your regular password) --
#   generate one at Google Account > Security > 2-Step Verification > App Passwords
# ADMIN_NOTIFICATION_EMAIL: where new-reservation/new-message alerts go
#   (defaults to EMAIL_USER if not set)
#
# Email is optional. If unset, notifications are skipped instead of
# crashing the API, but reservations and messages will not send alerts.
EMAIL_USER=
EMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=