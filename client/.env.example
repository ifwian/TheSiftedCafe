# Base URL of the Express API.
#
# Leave this UNSET in production. On Vercel the client and the API share
# one domain -- vercel.json rewrites /api/* to the server service -- so the
# app falls back to the relative path "/api" and needs no configuration.
#
# Set it only when the API runs on a different origin, which is the local
# development case (Vite dev server on :5173, Express on :5000).
VITE_API_BASE_URL=http://localhost:5000/api

# Cloudinary (unsigned upload preset, used only in the admin Menu form)
# Cloud name: Cloudinary dashboard > home page, top right
# Upload preset: Settings > Upload > Upload presets > Add upload preset
#   (mode: Unsigned; optionally restrict folder to the-sifted-cafe/menu)
#
# NOTE: an unsigned upload preset is public by design -- anyone can upload
# to it. For an admin-only feature, create a signed preset and verify the
# signature server-side before treating an upload as trusted.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=