# Base URL of the Express API (see server/.env)
VITE_API_URL=http://localhost:5000/api

# Cloudinary (unsigned upload preset, used only in the admin Menu form)
# Cloud name: Cloudinary dashboard > home page, top right
# Upload preset: Settings > Upload > Upload presets > Add upload preset
#   (mode: Unsigned; optionally restrict folder to the-sifted-cafe/menu)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
