# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (added in Milestone 09)
# Example: postgresql://user:password@localhost:5432/the_sifted_cafe
DATABASE_URL=postgresql://user:password@localhost:5432/the_sifted_cafe

# JWT signing secret (added in Milestone 14) -- use a long random string
JWT_SECRET=

# Gmail SMTP for reservation/message email notifications
# EMAIL_USER: the Gmail address sending notifications
# EMAIL_APP_PASSWORD: a Gmail App Password (NOT your regular password) --
#   generate one at Google Account > Security > 2-Step Verification > App Passwords
# ADMIN_NOTIFICATION_EMAIL: where new-reservation/new-message alerts go
#   (defaults to EMAIL_USER if not set)
EMAIL_USER=
EMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
